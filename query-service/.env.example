# Query service configuration. The target dataset is discovered from the
# bucket itself: dataset-engine commits config.json markers at every dataset
# root, so only the bucket is required. Optional SAB_DATASET_PREFIX narrows
# the scan and SAB_DATASET_NAME selects one dataset when the bucket holds
# several. Passing no dataset name requires the bucket to hold exactly one.
SAB_DATASET_BUCKET=supplier-ai

# Optional discovery scoping:
SAB_DATASET_PREFIX=
SAB_DATASET_NAME=

# Optional region and S3 credential overrides; blank uses the AWS SDK
# credential chain (instance role, AWS_PROFILE, etc).
SAB_DATASET_REGION=
SAB_S3_ENDPOINT_URL=
SAB_S3_ACCESS_KEY_ID=
SAB_S3_SECRET_ACCESS_KEY=

# Embedding endpoint for semantic_search; must serve the model recorded in
# the dataset's committed config.json (see list_datasets output).
SAB_EMBED_BASE_URL=http://localhost:11434/v1
SAB_EMBED_API_KEY=ollama

# SQL tuning (names the DuckDB settings):
SAB_SQL_MEMORY_LIMIT=512MB
SAB_SQL_THREADS=2
