# Root .env for the Compose stack. Deployment glue only.
#
# The dataset target and source wiring live centrally in
# dataset-engine/config/workspace.yaml, which is mounted by BOTH services.
# dataset-engine indexes it; query-service serves the committed dataset
# from the same file (bucket discovery only as fallback).

# Embedding endpoint overrides (optional). Unset values fall back to the
# embeddings: section in workspace.yaml. Under --profile gpu point both at
# the vLLM service on the compose network:
#   SAB_EMBED_BASE_URL=http://vllm:8000/v1
SAB_EMBED_BASE_URL=
SAB_EMBED_API_KEY=
SAB_EMBED_MODEL=

# Optional query-service SQL tuning (workspace.yaml query: section instead):
SAB_SQL_MEMORY_LIMIT=
SAB_SQL_THREADS=

AWS_REGION=us-west-2
OPENAI_API_KEY=
